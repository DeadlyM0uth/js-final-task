# Шаблон конфигурации. Скопируйте в .env и замените все ЗАМЕНИТЕ_МЕНЯ.
# .env в git не попадает. Токены и пароли нигде публично не размещайте.

# --- домен и HTTPS (Caddy) ---
DOMAIN=todo.smirnov-vadim.ru

# --- данные автора из профиля Moodle (сервер ставит их сам) ---
OWNER_LOGIN=vadim_smirnov_4150
OWNER_FULL_NAME=Смирнов Вадим Андреевич

# --- токен Bearer для /api/ ---
# Сгенерировать новый: npm run token:gen   (64 hex-символа)
API_TOKEN=ЗАМЕНИТЕ_МЕНЯ_64_СИМВОЛА

# --- база ---
DB_NAME=todo_students
COLLECTION_NAME=tasks

# --- администратор MongoDB (создаётся контейнером при первом старте) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=ЗАМЕНИТЕ_МЕНЯ_ROOT

# --- пользователь приложения ---
MONGO_APP_USER=todo_app
MONGO_APP_PASSWORD=ЗАМЕНИТЕ_МЕНЯ_APP

# --- пользователь для проверяющего: только коллекция tasks ---
MONGO_CHECKER_USER=todo_checker
MONGO_CHECKER_PASSWORD=ЗАМЕНИТЕ_МЕНЯ_CHECKER

# --- порт, на который Mongo опубликована на localhost (для SSH-туннеля) ---
MONGO_PUBLISH_PORT=27017

# --- только для запуска БЕЗ docker (локальная разработка) ---
# MONGO_URI=mongodb://todo_app:ПАРОЛЬ@127.0.0.1:27017/todo_students?authSource=todo_students
# MONGO_ADMIN_URI=mongodb://root:ПАРОЛЬ@127.0.0.1:27017/?authSource=admin
# BASE_URL=http://127.0.0.1:3000
